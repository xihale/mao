{
  "name": "mao-selected-works",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "bunx --bun astro dev",
    "build": "bunx --bun astro build && bunx pagefind --site dist && cp -r dist/pagefind public/pagefind",
    "preview": "bunx --bun astro preview",
    "extract": "bun run extract-epub.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "astro": "^5.7.10",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
