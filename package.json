{
  "name": "mao-selected-works",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "bunx --bun astro dev",
    "check": "astro check",
    "build": "bunx --bun astro build && node scripts/pagefind.mjs",
    "build:search": "bunx --bun astro build && node scripts/pagefind.mjs --force",
    "preview": "bunx --bun astro preview",
    "extract": "bun run extract-epub.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "astro": "7.1.6",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.5.2",
    "typescript": "6"
  }
}
