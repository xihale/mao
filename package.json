{
  "name": "mao-selected-works",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "bunx --bun astro dev",
    "check": "astro check",
    "build": "bunx --bun astro build && node scripts/pagefind.mjs",
    "preview": "bunx --bun astro preview",
    "extract": "bun run extract-epub.mjs",
    "fonts:subset": "python3 scripts/subset-font.py",
    "fonts:download": "mkdir -p public/fonts && curl -fsSL -o /tmp/fonts-subset.zip \"https://github.com/xihale/mao/releases/download/fonts/fonts-subset.zip\" && unzip -o /tmp/fonts-subset.zip -d public/fonts"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "astro": "7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.5.2",
    "typescript": "6",
    "xml2js": "^0.6.2"
  }
}
