{
  "name": "mao-selected-works",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "bunx --bun astro dev",
    "check": "astro check && tsc --noEmit -p tsconfig.json && eslint .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.json",
    "build": "astro build && pagefind --site dist",
    "build:epub": "bun run src/scripts/epub.ts",
    "preview": "bunx --bun astro preview"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "astro": "7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^26.1.2",
    "epub-gen-memory": "^1.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.0.1",
    "globals": "^17.8.0",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "markdown-it": "^15.0.0",
    "markdown-it-footnote": "^4.0.0",
    "pagefind": "^1.5.2",
    "typescript": "6",
    "typescript-eslint": "^8.65.0"
  }
}
