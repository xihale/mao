---
import Layout from '../layouts/Layout.astro';
---

<Layout title="搜索">
  <div class="search-wrap">
    <input type="text" id="q" placeholder="搜索文章..." autocomplete="off" />
    <button id="clear" type="button" aria-label="清空" hidden>×</button>
  </div>

  <div id="status" class="status"></div>
  <div id="results" class="results"></div>
</Layout>

<script>
  import { initSearch } from '../scripts/search';
  void initSearch();
</script>

<style>
  .back { font-size: 0.75rem; color: var(--text3); }

  .search-wrap {
    position: relative;
    margin: 1.5rem 0 1rem;
  }
  .search-wrap input {
    width: 100%;
    padding: 0.55rem 1.75rem 0.55rem 0;
    border: none;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    font-family: var(--serif);
    font-size: 0.85rem;
    background: transparent;
    color: var(--text);
  }
  .search-wrap input::placeholder { color: var(--text3); }
  .search-wrap input:focus {
    outline: none;
    border-bottom-color: #444;
  }
  .search-wrap #clear {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    border: none;
    background: none;
    color: var(--text3);
    font-size: 1.05rem;
    line-height: 1;
    padding: 0.2rem 0.1rem;
    cursor: pointer;
  }
  .search-wrap #clear:hover { color: var(--text); }

  .status {
    font-size: 0.75rem;
    color: var(--text3);
    margin-bottom: 0.8rem;
  }

  .results {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .result-card {
    display: block;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg2);
  }
  .result-card:hover { border-color: #444; }
  .result-title {
    font-size: 0.85rem;
    color: var(--text);
    margin-bottom: 0.2rem;
  }

  .result-excerpt,
  .sub-excerpt {
    font-size: 0.75rem;
    color: var(--text3);
    line-height: 1.45;
  }
  .result-excerpt :global(mark),
  .sub-excerpt :global(mark) {
    color: var(--text);
    background: none;
    font-weight: 600;
  }

  .sub-result {
    margin-top: 0.3rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--line);
  }
  .sub-title {
    display: block;
    font-size: 0.75rem;
    color: var(--text2);
  }
  .sub-excerpt {
    display: block;
    font-size: 0.7rem;
    line-height: 1.4;
  }
</style>
