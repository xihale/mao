---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const articles = await getCollection('volumes');
const volumes = [1, 2, 3, 4, 5, 6, 7];
const volumeLabels: Record<number, string> = {
  1: '第一卷', 2: '第二卷', 3: '第三卷', 4: '第四卷',
  5: '第五卷', 6: '第六卷（静火版）', 7: '第七卷（静火版）'
};

const grouped = volumes.map(v => ({
  volume: v,
  label: volumeLabels[v],
  articles: articles
    .filter(a => a.data.volume === v)
    .sort((a, b) => a.data.order - b.data.order)
}));
---

<Layout title="目录">
  <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:2rem;">
    <div>
      <h1 style="font-size:1.6rem;margin-bottom:0.3rem;">毛泽东选集</h1>
      <p style="font-size:0.85rem;color:var(--text2);">全七卷 · {articles.length} 篇</p>
    </div>
    <a href="/search" class="search-icon" aria-label="搜索">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
    </a>
  </div>

  {grouped.map(g => (
    <section style="margin-bottom:2rem;">
      <h2 style="font-size:0.9rem;color:var(--text2);padding-bottom:0.4rem;border-bottom:1px solid var(--line);margin-bottom:0.3rem;">{g.label}</h2>
      <ol style="list-style:none;padding:0;">
        {g.articles.map(article => (
          <li>
            <a href={`/volumes/${article.id}`} style="display:flex;justify-content:space-between;align-items:baseline;gap:0.75rem;padding:0.35rem 0;">
              <span>{article.data.title}</span>
              {article.data.date && <span style="font-size:0.75rem;color:var(--text3);white-space:nowrap;">{article.data.date}</span>}
            </a>
          </li>
        ))}
      </ol>
    </section>
  ))}
</Layout>

<style>
  .search-icon {
    color: var(--text2);
    display: flex;
    align-items: center;
    padding: 0.5rem;
    border-radius: 6px;
    transition: color 0.15s;
  }
  .search-icon:hover { color: var(--text); }

  @media (max-width: 767px) {
    li a { flex-direction: column; gap: 0.1rem; }
  }
</style>
