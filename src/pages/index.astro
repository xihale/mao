---
import Layout from '../layouts/Layout.astro';
import { articleHref, getArticlesSorted, groupByVolume } from '../lib/volumes';

const articles = await getArticlesSorted();
const grouped = groupByVolume(articles);
---

<Layout title="目录">
  <div class="header">
    <div>
      <h1>毛泽东选集</h1>
    </div>
    <a href="/search" class="search-icon" aria-label="搜索">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
    </a>
  </div>

  {grouped.map((g) => (
    <section class="vol">
      <h2>{g.label}</h2>
      <ol>
        {g.articles.map((a) => (
          <li>
            <a href={articleHref(a)}>
              <span>{a.data.title}</span>
              {a.data.date && <time>{a.data.date}</time>}
            </a>
          </li>
        ))}
      </ol>
    </section>
  ))}
</Layout>

<style>
  .header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2rem;
  }
  h1 { font-size: 1.4rem; margin-bottom: 0.3rem; }
  .sub { font-size: 0.78rem; color: var(--text2); }

  .search-icon {
    color: var(--text2);
    display: flex;
    align-items: center;
    padding: 0.3rem;
    border-radius: 4px;
  }
  .search-icon:hover { color: var(--text); }

  .vol { margin-bottom: 2rem; }
  .vol h2 {
    font-size: 0.82rem;
    color: var(--text2);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 0.3rem;
  }
  ol { list-style: none; padding: 0; }
  li a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.35rem 0;
  }
  time {
    font-size: 0.7rem;
    color: var(--text3);
    white-space: nowrap;
  }
  @media (max-width: 767px) {
    li a { flex-direction: column; gap: 0.1rem; }
  }
</style>
