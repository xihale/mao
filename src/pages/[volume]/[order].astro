---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('volumes');
  const sorted = articles.sort((a, b) => {
    if (a.data.volume !== b.data.volume) return a.data.volume - b.data.volume;
    return a.data.order - b.data.order;
  });
  return sorted.map((article, idx) => ({
    params: { volume: String(article.data.volume), order: String(article.data.order) },
    props: {
      article,
      prev: idx > 0 ? sorted[idx - 1] : null,
      next: idx < sorted.length - 1 ? sorted[idx + 1] : null,
    },
  }));
}

const { article, prev, next } = Astro.props;
const { Content } = await render(article);
---

<Layout title={article.data.title}>
  <h1 data-pagefind-meta="title" style="font-size:1.3rem;margin:0.8rem 0 0.3rem;">{article.data.title}</h1>
  <p style="font-size:0.75rem;color:var(--text2);margin-bottom:1.5rem;padding-bottom:1rem;border-bottom:1px solid var(--line);">
    {article.data.period && <>{article.data.period}</>}
    {article.data.period && article.data.date && <> · </>}
    {article.data.date && <>{article.data.date}</>}
  </p>

  <article class="content" data-pagefind-body>
    <Content />
  </article>

  <nav style="display:flex;justify-content:space-between;margin-top:3rem;gap:1rem;">
    {prev && <a href={`/${prev.data.volume}/${prev.data.order}`} style="font-size:0.78rem;color:var(--text2);max-width:45%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">&larr; {prev.data.title}</a>}
    {!prev && <span />}
    {next && <a href={`/${next.data.volume}/${next.data.order}`} style="font-size:0.78rem;color:var(--text2);max-width:45%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{next.data.title} &rarr;</a>}
  </nav>
</Layout>

<style>
  .content {
    line-height: 1.55;
    font-size: 1rem;
  }

  .content :global(h1) { display: none; }

  .content :global(h2) {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 2rem 0 1rem;
  }

  .content :global(h3) {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 1.5rem 0 0.8rem;
  }

  .content :global(p) {
    margin-bottom: 1rem;
    text-indent: 2em;
  }

  .content :global(blockquote) {
    border-left: 2px solid var(--line);
    padding-left: 1rem;
    color: var(--text2);
    margin: 1.5rem 0;
  }

  .content :global(blockquote p) { text-indent: 0; }

  .content :global(strong) { font-weight: 600; }

  .content :global(mark.pagefind-highlight) {
    color: #ffce5e;
    background: none;
    font-weight: 600;
  }

  .content :global(sup) { color: var(--text3); font-size: 0.7em; }

  .content :global(.footnote-ref) {
    color: var(--text3);
    text-decoration: none;
    font-size: 0.75em;
    vertical-align: super;
  }

  .content :global(.footnotes) {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--text2);
  }

  .content :global(.footnotes h2) { display: none; }

  .content :global(.footnotes ol) { padding-left: 1.2rem; }

  .content :global(.footnotes li) {
    margin-bottom: 0.5rem;
    line-height: 1.55;
    text-indent: 0;
  }

  .content :global(.footnotes li p) { text-indent: 0; margin-bottom: 0; }

  .content :global(.footnotes li:target) {
    background: var(--bg2);
    padding: 0.2rem 0.4rem;
    border-radius: 2px;
  }

  .content :global(.footnotes .data-footnote-backref) {
    color: var(--text3);
    text-decoration: none;
    margin-left: 0.4em;
  }

  .content :global(.footnotes .data-footnote-backref:hover) {
    color: var(--text2);
  }

  .content :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 2rem 0;
  }

  .content :global(ol),
  .content :global(ul) {
    padding-left: 2em;
    margin-bottom: 1rem;
  }

  .content :global(li) { margin-bottom: 0.3rem; }

  @media (max-width: 767px) {
    .content { font-size: 0.95rem; }
  }


  /* 移动端浮动按钮 */
  .sel-fab {
    display: none;
    position: fixed;
    z-index: 999;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.75rem;
    color: var(--text);
    background: var(--bg2);
    border: 1px solid var(--line);
    box-shadow: 0 2px 12px rgba(0,0,0,0.4);
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  @media (pointer: coarse) {
    .sel-fab { display: block; }
  }
</style>

<script>
  // ── 相对位置选段分享 ──────────────────────────────────────
  // 用纯文本偏移 [start,end] 定位，hash 格式 #start-end（如 #234-567）。
  // 正文为固定历史文本，不存编辑偏移，故无需容错锚点。
  const ARTICLE_SEL = 'article.content';

  // ── DOM ↔ 纯文本偏移 ──

  function getTextOffset(root: Node, node: Node, offset: number): number {
    const tw = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    let charIdx = 0;
    let n: Text | null;
    while ((n = tw.nextNode() as Text | null)) {
      if (n === node) return charIdx + offset;
      charIdx += n.nodeValue?.length ?? 0;
    }
    return charIdx;
  }

  function setSelectionFromOffsets(root: Node, startOff: number, endOff: number): Range | null {
    const tw = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    let charIdx = 0;
    let n: Text | null;
    let startNode: Text | null = null, startOffset = 0;
    let endNode: Text | null = null, endOffset = 0;
    while ((n = tw.nextNode() as Text | null)) {
      const len = n.nodeValue?.length ?? 0;
      if (!startNode && charIdx + len >= startOff) {
        startNode = n;
        startOffset = startOff - charIdx;
      }
      if (charIdx + len >= endOff) {
        endNode = n;
        endOffset = endOff - charIdx;
        break;
      }
      charIdx += len;
    }
    if (!startNode || !endNode) return null;
    const range = document.createRange();
    range.setStart(startNode, startOffset);
    range.setEnd(endNode, endOffset);
    return range;
  }

  // ── 高亮 & 滚动 ──

  function highlightRange(range: Range, scroll: boolean = false) {
    const hl = new Highlight(range);
    CSS.highlights.set('sel-hl', hl);

    if (scroll) {
      // 用 getBoundingClientRect 精确计算滚动位置
      const rect = range.getBoundingClientRect();
      const targetY = window.scrollY + rect.top - window.innerHeight / 2 + rect.height / 2;
      window.scrollTo({ top: Math.max(0, targetY), behavior: 'smooth' });
    }

    setTimeout(() => CSS.highlights.delete('sel-hl'), 2500);
  }

  // ── 复制链接 ──

  function copyLink(start: number, end: number) {
    const url = `${location.origin}${location.pathname}#${start}-${end}`;
    navigator.clipboard.writeText(url).then(() => {
      toast('已复制');
    }).catch(() => {
      // fallback
      const ta = document.createElement('textarea');
      ta.value = url;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      toast('已复制');
    });
  }

  function getSelectedOffsets(): [number, number] | null {
    const sel = window.getSelection();
    const article = document.querySelector(ARTICLE_SEL);
    if (!sel || sel.isCollapsed || !article || !sel.rangeCount) return null;
    const range = sel.getRangeAt(0);
    if (!article.contains(range.commonAncestorContainer)) return null;
    const start = getTextOffset(article, range.startContainer, range.startOffset);
    const end = getTextOffset(article, range.endContainer, range.endOffset);
    if (start === end) return null;
    return [start, end];
  }

  /** 触点是否落在当前选区（允许多行 rect + 手指 padding） */
  function pointInSelection(x: number, y: number, pad = 10): boolean {
    const sel = window.getSelection();
    if (!sel || sel.isCollapsed || !sel.rangeCount) return false;
    const range = sel.getRangeAt(0);
    const article = document.querySelector(ARTICLE_SEL);
    if (!article || !article.contains(range.commonAncestorContainer)) return false;
    const rects = range.getClientRects();
    for (let i = 0; i < rects.length; i++) {
      const r = rects[i];
      if (
        x >= r.left - pad && x <= r.right + pad &&
        y >= r.top - pad && y <= r.bottom + pad
      ) return true;
    }
    return false;
  }

  let lastCopyAt = 0;
  function copySelectionLink(offsets: [number, number]) {
    const now = Date.now();
    if (now - lastCopyAt < 800) return; // 防 touch 长按 + contextmenu 双触发
    lastCopyAt = now;
    copyLink(offsets[0], offsets[1]);
  }

  // ── Toast ──

  function toast(msg: string) {
    const el = document.createElement('div');
    el.textContent = msg;
    Object.assign(el.style, {
      position: 'fixed',
      bottom: '2rem',
      left: '50%',
      transform: 'translateX(-50%)',
      padding: '8px 20px',
      borderRadius: '9999px',
      fontSize: '0.85rem',
      color: 'var(--text)',
      background: 'var(--bg2)',
      border: '1px solid var(--line)',
      zIndex: '9999',
      opacity: '0',
      transition: 'opacity 0.3s',
      pointerEvents: 'none',
    });
    document.body.appendChild(el);
    requestAnimationFrame(() => el.style.opacity = '1');
    setTimeout(() => {
      el.style.opacity = '0';
      setTimeout(() => el.remove(), 300);
    }, 2000);
  }

  // ── 桌面端：Ctrl+Shift+C ──

  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.shiftKey && e.key === 'C') {
      e.preventDefault();
      const offsets = getSelectedOffsets();
      if (!offsets) return;
      copyLink(offsets[0], offsets[1]);
    }
  });

  // ── 移动端：选中后长按选区 → 复制相对位置链接 ──
  // Android：先划选/点选，再长按已选文字；避免「第一次长按出选区」被误触发。
  // 另保留浮动按钮作为兜底。

  const isCoarsePointer = () => matchMedia('(pointer: coarse)').matches;

  const fab = document.createElement('button');
  fab.className = 'sel-fab';
  fab.textContent = '复制链接';
  fab.hidden = true;
  document.body.appendChild(fab);

  let fabVisible = false;

  function showFab() {
    const sel = window.getSelection();
    if (!sel || sel.isCollapsed || !sel.rangeCount) { hideFab(); return; }
    if (!getSelectedOffsets()) { hideFab(); return; }
    const range = sel.getRangeAt(0);
    const rect = range.getBoundingClientRect();
    // position:fixed 用视口坐标，不要加 scrollY
    fab.style.top = `${Math.max(8, rect.top - 44)}px`;
    fab.style.left = `${Math.max(8, Math.min(rect.left + rect.width / 2 - 50, window.innerWidth - 120))}px`;
    fab.hidden = false;
    fabVisible = true;
  }

  function hideFab() {
    fab.hidden = true;
    fabVisible = false;
  }

  document.addEventListener('selectionchange', () => {
    requestAnimationFrame(() => {
      const sel = window.getSelection();
      if (!sel || sel.isCollapsed) {
        setTimeout(hideFab, 150);
      } else if (isCoarsePointer()) {
        showFab();
      }
    });
  });

  fab.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    const offsets = getSelectedOffsets();
    if (!offsets) return;
    copySelectionLink(offsets);
    hideFab();
  });

  const LONG_PRESS_MS = 480;
  const MOVE_CANCEL_PX = 14;
  let pressTimer: ReturnType<typeof setTimeout> | null = null;
  /** touchstart 时已有的选区；null = 本次手势不是「在已有选区上长按」 */
  let pressOffsets: [number, number] | null = null;
  let pressX = 0;
  let pressY = 0;

  function clearLongPress() {
    if (pressTimer !== null) {
      clearTimeout(pressTimer);
      pressTimer = null;
    }
  }

  function fireLongPressCopy() {
    const offsets = pressOffsets;
    clearLongPress();
    pressOffsets = null;
    if (!offsets) return;
    copySelectionLink(offsets);
    hideFab();
    try { navigator.vibrate?.(15); } catch { /* ignore */ }
  }

  document.addEventListener('touchstart', (e) => {
    clearLongPress();
    pressOffsets = null;

    if (fabVisible && e.target !== fab) {
      setTimeout(hideFab, 200);
    }

    if (!isCoarsePointer() || e.touches.length !== 1) return;

    const t = e.touches[0];
    // 必须 touchstart 时就已有选区，且点在选区上
    const offsets = getSelectedOffsets();
    if (!offsets || !pointInSelection(t.clientX, t.clientY)) return;

    pressOffsets = offsets;
    pressX = t.clientX;
    pressY = t.clientY;
    pressTimer = setTimeout(fireLongPressCopy, LONG_PRESS_MS);
  }, { passive: true });

  document.addEventListener('touchmove', (e) => {
    if (pressTimer === null || !e.touches.length) return;
    const t = e.touches[0];
    if (
      Math.abs(t.clientX - pressX) > MOVE_CANCEL_PX ||
      Math.abs(t.clientY - pressY) > MOVE_CANCEL_PX
    ) {
      clearLongPress();
      pressOffsets = null;
    }
  }, { passive: true });

  document.addEventListener('touchend', () => {
    clearLongPress();
    // 保留 pressOffsets 一小会儿，供紧随其后的 contextmenu 使用
    setTimeout(() => { pressOffsets = null; }, 50);
  }, { passive: true });

  document.addEventListener('touchcancel', () => {
    clearLongPress();
    pressOffsets = null;
  }, { passive: true });

  // Android 长按常伴随 contextmenu；在「已有选区上长按」时接管并复制
  document.addEventListener('contextmenu', (e) => {
    if (!isCoarsePointer()) return;
    // 刚通过计时器复制过：吞掉原生菜单，避免闪一下
    if (Date.now() - lastCopyAt < 800) {
      e.preventDefault();
      return;
    }
    // 仅当本次手势开始时已有选区（pressOffsets），避免首次长按选词被劫持
    if (!pressOffsets) return;
    if (!pointInSelection(e.clientX, e.clientY, 24)) return;
    e.preventDefault();
    fireLongPressCopy();
  });

  // ── Hash 解析 & 跳转 ──

  function handleHash() {
    // 匹配 #start-end，如 #234-567
    const m = location.hash.match(/^#(\d+)-(\d+)$/);
    if (!m) return;

    const start = parseInt(m[1], 10);
    const end = parseInt(m[2], 10);
    if (end <= start) return;

    const article = document.querySelector(ARTICLE_SEL);
    if (!article) return;

    const range = setSelectionFromOffsets(article, start, end);
    if (range) highlightRange(range, true);
  }

  // 页面加载后处理 hash
  // 等字体加载完再定位，避免布局偏移导致位置不准
  if (location.hash.match(/^#\d+-\d+$/)) {
    document.fonts.ready.then(() => {
      // 先跳到顶部，再定位
      window.scrollTo(0, 0);
      requestAnimationFrame(() => handleHash());
    });
  }

  // ── Footnote 平滑跳转 ──

  function smoothScrollTo(target: Element, isRef = false) {
    const y = target.getBoundingClientRect().top + window.scrollY - window.innerHeight * 0.2;
    window.scrollTo({ top: y, behavior: 'smooth' });

    // 暖色高亮：在深色背景上醒目；持续 2.5s（明显一些、时间长一些）
    const bg = 'rgba(255, 196, 87, 0.25)';
    const duration = 2500;

    if (isRef) {
      // 回跳正文序号：序号本身很小，靠 box-shadow 光晕向外扩散 + 数字变亮，确保一眼可见
      // id 在 <a> 上（GFM 输出 <sup><a id="fnref-1">1</a></sup>），直接用 target 即可
      const glow = '0 0 0 4px rgba(255, 196, 87, 0.25)';
      target.animate(
        [
          { backgroundColor: 'transparent', color: 'var(--text3)', boxShadow: 'none' },
          { backgroundColor: bg, color: '#ffce5e', boxShadow: glow, offset: 0.1 },
          { backgroundColor: bg, color: '#ffce5e', boxShadow: glow, offset: 0.75 },
          { backgroundColor: 'transparent', color: 'var(--text3)', boxShadow: 'none' },
        ],
        { duration, easing: 'ease-out' },
      );
    } else {
      target.animate(
        [
          { backgroundColor: 'transparent' },
          { backgroundColor: bg, offset: 0.1 },
          { backgroundColor: bg, offset: 0.75 },
          { backgroundColor: 'transparent' },
        ],
        { duration, easing: 'ease-out' },
      );
    }
  }

  document.querySelector(ARTICLE_SEL)?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    // 跳转到脚注
    const fnRef = target.closest('a[data-footnote-ref]');
    if (fnRef) {
      e.preventDefault();
      const id = fnRef.getAttribute('href')?.slice(1);
      if (!id) return;
      const footnote = document.getElementById(id);
      if (footnote) smoothScrollTo(footnote);
      return;
    }
    // 跳回正文
    const backRef = target.closest('a.data-footnote-backref');
    if (backRef) {
      e.preventDefault();
      const id = backRef.getAttribute('href')?.slice(1);
      if (!id) return;
      const ref = document.getElementById(id);
      // 回跳的目标是正文里的上标序号，专门做序号高亮
      if (ref) smoothScrollTo(ref, true);
    }
  });

  // hashchange
  window.addEventListener('hashchange', handleHash);
</script>

<!-- 搜索结果跳转高亮：单独 inline 脚本，避免被 Vite preload 包装影响动态 import -->
<script type="module" is:inline>
  if (new URLSearchParams(location.search).getAll('pagefind-highlight').length) {
    import('/pagefind/pagefind-highlight.js').then(({ default: PagefindHighlight }) => {
      new PagefindHighlight({
        addStyles: false,                // 关掉默认黄底黑字，用站点暖色字色
        highlightParam: 'pagefind-highlight',
      });
      document.querySelector('mark.pagefind-highlight')
        ?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }
</script>
