---
import Layout from '../../layouts/Layout.astro';
import { render } from 'astro:content';
import { getArticlesSorted, type Article } from '../../lib/volumes';

export async function getStaticPaths() {
  const sorted = await getArticlesSorted();
  return sorted.map((article, idx) => ({
    params: { volume: String(article.data.volume), order: String(article.data.order) },
    props: {
      article,
      prev: idx > 0 ? sorted[idx - 1] : null,
      next: idx < sorted.length - 1 ? sorted[idx + 1] : null,
    },
  }));
}

interface Props {
  article: Article;
  prev: Article | null;
  next: Article | null;
}

const { article, prev, next } = Astro.props;
const { Content } = await render(article);

const meta = [article.data.period, article.data.date].filter(Boolean).join(' · ');
---

<Layout title={article.data.title}>
  <h1 data-pagefind-meta="title">{article.data.title}</h1>
  {meta && <p class="meta">{meta}</p>}

  <article class="content" data-pagefind-body>
    <Content />
  </article>

  <nav class="pager">
    {prev
      ? <a href={`/${prev.data.volume}/${prev.data.order}`}>&larr; {prev.data.title}</a>
      : <span />}
    {next && <a href={`/${next.data.volume}/${next.data.order}`}>{next.data.title} &rarr;</a>}
  </nav>
</Layout>

<style>
  h1 {
    font-size: 1.3rem;
    margin: 0.8rem 0 0.3rem;
  }
  .meta {
    font-size: 0.75rem;
    color: var(--text2);
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    margin-top: 3rem;
    gap: 1rem;
  }
  .pager a {
    font-size: 0.78rem;
    color: var(--text2);
    max-width: 45%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .content {
    line-height: 1.55;
    font-size: 1rem;
  }
  .content :global(h1) { display: none; }
  .content :global(h2) {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 2rem 0 1rem;
  }
  .content :global(h3) {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 1.5rem 0 0.8rem;
  }
  .content :global(p) {
    margin-bottom: 1rem;
    text-indent: 2em;
  }
  .content :global(blockquote) {
    border-left: 2px solid var(--line);
    padding-left: 1rem;
    color: var(--text2);
    margin: 1.5rem 0;
  }
  .content :global(blockquote p) { text-indent: 0; }
  .content :global(strong) { font-weight: 600; }
  .content :global(mark.pagefind-highlight) {
    color: #ffce5e;
    background: none;
    font-weight: 600;
  }
  .content :global(sup) { color: var(--text3); font-size: 0.7em; }
  .content :global(.footnote-ref) {
    color: var(--text3);
    text-decoration: none;
    font-size: 0.75em;
    vertical-align: super;
  }
  .content :global(.footnotes) {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--text2);
  }
  .content :global(.footnotes h2) { display: none; }
  .content :global(.footnotes ol) { padding-left: 1.2rem; }
  .content :global(.footnotes li) {
    margin-bottom: 0.5rem;
    line-height: 1.55;
    text-indent: 0;
  }
  .content :global(.footnotes li p) { text-indent: 0; margin-bottom: 0; }
  .content :global(.footnotes li:target) {
    background: var(--bg2);
    padding: 0.2rem 0.4rem;
    border-radius: 2px;
  }
  .content :global(.footnotes .data-footnote-backref) {
    color: var(--text3);
    text-decoration: none;
    margin-left: 0.4em;
  }
  .content :global(.footnotes .data-footnote-backref:hover) { color: var(--text2); }
  .content :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 2rem 0;
  }
  .content :global(ol),
  .content :global(ul) {
    padding-left: 2em;
    margin-bottom: 1rem;
  }
  .content :global(li) { margin-bottom: 0.3rem; }

  @media (max-width: 767px) {
    .content { font-size: 1.12rem; }
    h1 { font-size: 1.4rem; }
  }

  /* Dynamically created on document.body — must be :global */
  :global(.toast) {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 20px;
    border-radius: 9999px;
    font-size: 0.85rem;
    color: var(--text);
    background: var(--bg2);
    border: 1px solid var(--line);
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  :global(.toast.show) { opacity: 1; }
</style>

<script>
  import { initArticle } from '../../scripts/article';
  initArticle();
</script>

<script type="module" is:inline>
  if (new URLSearchParams(location.search).getAll('pagefind-highlight').length) {
    import('/pagefind/pagefind-highlight.js').then(({ default: PagefindHighlight }) => {
      new PagefindHighlight({ addStyles: false, highlightParam: 'pagefind-highlight' });
      document.querySelector('mark.pagefind-highlight')
        ?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }
</script>
